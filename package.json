{
  "name": "dsh-plugin-grok-bot",
  "version": "0.1.0",
  "description": "Native DSH tools, a /grokbot command and a bundled skill for Grok Bot: list bots and groups, send messages, and read threaded replies.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "grok",
    "grok-bot",
    "gbot",
    "tools",
    "skill",
    "slash-command"
  ],
  "license": "MIT",
  "author": "quafulz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quafulz/dsh-plugin-grok-bot.git"
  },
  "homepage": "https://github.com/quafulz/dsh-plugin-grok-bot#readme",
  "bugs": {
    "url": "https://github.com/quafulz/dsh-plugin-grok-bot/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx/esm --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
